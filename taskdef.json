{
  "family": "rca-copilot",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::846280826593:role/rca-copilot-execution-role",
  "taskRoleArn": "arn:aws:iam::846280826593:role/rca-copilot-task-role",
  "containerDefinitions": [
    {
      "name": "rca-copilot",
      "image": "846280826593.dkr.ecr.ap-south-1.amazonaws.com/rca-copilot:af638cb",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "INCIDENTS_TABLE",
          "value": "rca-copilot-incidents"
        },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "http://localhost:4317"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
          "value": "http://localhost:4318/v1/metrics"
        }
      ],

      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-south-1:846280826593:parameter/rca-copilot/anthropic-api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rca-copilot",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },

      "essential": true
    },
    {
      "name": "aws-otel-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:latest",
      "essential": false,
      "secrets": [
        {
          "name": "AOT_CONFIG_CONTENT",
          "valueFrom": "arn:aws:ssm:ap-south-1:846280826593:parameter/rca-copilot/otel-collector-config"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rca-copilot",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "otel"
        }
      }
    }
    
  ]
}
